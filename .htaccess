# Digifyhub — repository root (Hostinger deploys the whole repo into public_html).
# The website itself lives in /docs and is served at the domain root.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One canonical host: https://digifyhub.tech (no http, no www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://digifyhub.tech%{REQUEST_URI} [L,R=301]

  # 2. Keep source and private files off the web
  RewriteRule ^(\.git|apps-script|src)(/|$) - [F,L]
  RewriteRule ^(build\.mjs|README\.md|SEO\.md|\.gitignore)$ - [F,L]

  # 3. Duplicate URLs -> canonical URLs (only when typed/linked, never on internal rewrites)
  RewriteCond %{THE_REQUEST} \s/+docs/([^\s?]*) [NC]
  RewriteRule ^ /%1 [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]

  # 4. Serve the website from /docs
  RewriteCond %{REQUEST_URI} !^/docs/
  RewriteRule ^(.*)$ /docs/$1 [L]
</IfModule>
